# Copy to .env to override the local defaults in docker-compose.yml.
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
SEASON=2027
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me
TIMING_SEASONS=2024,2025,2026
READONLY_DB_PASSWORD=change-me

# Triage agent. Everything below is optional: without a key the agent writes
# evidence-only reports; without GitHub or Discord settings, reports go only to
# the agent-outbox volume.
ANTHROPIC_API_KEY=
AGENT_MONTHLY_BUDGET_USD=5
# Fine-grained token with "Issues: read and write" on the one repository.
GITHUB_TOKEN=
GITHUB_REPO=matthosch/trackside
# Discord channel settings > Integrations > Webhooks > Copy webhook URL.
DISCORD_WEBHOOK_URL=
